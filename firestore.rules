rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      // Allow reading any order (for customer order tracking + staff dashboard)
      allow read: if true;

      // Allow creating an order with validated fields
      allow create: if
        request.resource.data.tableNumber is int &&
        request.resource.data.tableNumber >= 1 &&
        request.resource.data.tableNumber <= 24 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 20 &&
        request.resource.data.status == 'received' &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() <= 60 &&
        request.resource.data.createdAt is string &&
        request.resource.data.total is number &&
        request.resource.data.total > 0 &&
        request.resource.data.total < 50000;

      // Allow updating only status and paymentStatus fields
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'paymentStatus']) &&
        request.resource.data.status in ['received', 'preparing', 'served'];

      // Never allow deletion
      allow delete: if false;
    }
  }
}
